#!/usr/bin/env bash
# Wrapper around `flutter` that forwards KEY=value entries from `.env` as
# --dart-define flags (iOS/macOS/desktop, or when not building via Gradle).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

DEFINES=()
ENV_FILE="$ROOT/.env"
if [[ -f "$ENV_FILE" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="$(echo "$line" | xargs)"
    [[ -z "$line" ]] && continue
    [[ "$line" != *=* ]] && continue
    key="${line%%=*}"
    value="${line#*=}"
    key="$(echo "$key" | xargs)"
    value="$(echo "$value" | xargs)"
    if [[ "$value" == \"*\" && "$value" == *\" ]]; then
      value="${value:1:${#value}-2}"
    elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
      value="${value:1:${#value}-2}"
    fi
    [[ -z "$key" || -z "$value" ]] && continue
    DEFINES+=(--dart-define="${key}=${value}")
  done < "$ENV_FILE"
fi

exec flutter "${DEFINES[@]}" "$@"
